@model IEnumerable<RoleViewModel>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<a asp-action="Create" class="btn btn-success"> Add New Role</a>

<h1>All Roles</h1>

@if (Model.Count() > 0)
{
    <div class="m-2">

        <form class="row offset-2" asp-action="index">
            <div class="col-8">
                <input type="text" name="searchValue" class="form-control" placeholder="Role Name" />
            </div>
            <div class="col-4">
                <input type="submit" class="btn btn-info" value="Search" />
            </div>

        </form>
    </div>
    <table class="table table-striped table-hover mt-5">
        <thead>

            <tr>
                <td>
                    @Html.DisplayNameFor(U => U.Id)
                </td>
                <td>
                    @Html.DisplayNameFor(U => U.RoleName)
                </td>
               
                <td>
                    Details
                </td>
                <td>
                    Update
                </td>
                <td>
                    Delete
                </td>
            </tr>
        </thead>
        <tbody>

            @foreach (var role in Model)
            {
                <tr>
                    <td>
                        @role.Id
                    </td>
                    <td>
                        @role.RoleName
                    </td>


                    <partial name="_ButtonPartialView" model="@role.Id" />
                </tr>
            }
        </tbody>

    </table>
}
else
{
    <div>
        <h1>
            There Is No Roles
        </h1>
    </div>
}

