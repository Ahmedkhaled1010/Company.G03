@model RoleViewModel
@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Edit Role @Model.RoleName</h1>



<form asp-action="Edit" >

    <div class="form-group">

        <label class="col-form-label" asp-for="Id">

        </label>
        <input readonly class="form-control" asp-for="Id" />
    </div>

    <div class="form-group">

        <label class="col-form-label" asp-for="RoleName">

        </label>
        <input class="form-control" asp-for="RoleName" />
    </div>
    
    

    <input type="submit" class="btn btn-warning" value="Save"/>
    <a asp-action="Index" class="btn btn-light"> Back to List</a>

</form>

