@model IEnumerable<EmployeeViewModel>
@{
    ViewData["Title"] = "Index";
    string VDataMessage = @ViewData["message"] as string;
    string VBigMessage = @ViewBag.x;
}

<div class="alert alert-success mb-4">
    @ViewData["message"]
</div>
<div class="alert alert-primary mb-4">
    @ViewBag.x
</div>
<a asp-action="Create" class="btn btn-success"> Add New Employee</a>
@if (Model.Count() > 0)
{
    <h1>All Employee</h1>
    <br />
    <div class="m-2">

        <form class="row offset-2" asp-action="index">
            <div class="col-8">
                <input type="text" name="search" class="form-control" placeholder="Employees Name" />
            </div>
            <div class="col-4">
                <input type="submit" class="btn btn-info" value="Search" />
            </div>

        </form>
    </div>
    <table class="table table-striped table-hover mt-3">
        <thead>
            <tr>

                <th>
                    @Html.DisplayNameFor(d => d.Image)
                </th>
                <th>
                    @Html.DisplayNameFor(d => d.Name)
                </th>
                <th>
                    @Html.DisplayNameFor(d => d.Age)
                </th>
                <th>
                    @Html.DisplayNameFor(d => d.Salary)
                </th>
               
                <th>
                    @Html.DisplayNameFor(d => d.Department)
                </th>
                <th>
                    @Html.DisplayNameFor(d => d.Address)
                </th>
                <th>
                    @Html.DisplayNameFor(d => d.Email)
                </th>
                <th>
                    @Html.DisplayNameFor(d => d.PhoneNumber)
                </th>
                <th>
                    @Html.DisplayNameFor(d => d.HireDate)
                </th>
                <th>
                    @Html.DisplayNameFor(d => d.IsActive)
                </th>
                <th>
                    Details
                </th>
                <th>
                    Update
                </th>
                <th>
                    Delete
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var emp in Model)
            {
                <tr>
                    <td>
                        <img src="~/Files/Images/@emp.ImageName" class="rounded " height="40" width="40" alt="@emp.ImageName" />
                    </td>
                    <td>
                        @emp.Name
                    </td>
                    <td>
                        @emp.Age
                    </td>
                    <td>
                        @Html.DisplayFor(e=>emp.Salary)
                    </td>
                     <td>
                        @Html.DisplayFor(e => emp.Department.Name)
                    </td>
                     <td>
                        @emp.Address
                    </td>
                    <td>
                        @Html.DisplayFor(e=>emp.Email)
                    </td>
                    <td>
                        @emp.PhoneNumber
                    </td>
                    <td>
                        @emp.HireDate
                    </td>
                    <td>
                        @if(emp.IsActive==true)
                        {
                            <i class="fa-solid fa-circle" style="color:green"></i>
                        }
                        else
                        {
                            <i class="fa-solid fa-circle" style="color:red"></i>

                        }
                    </td>
                    <partial name="_ButtonPartialView" Model="@emp.Id"></partial>

                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="mt-5 alert alert-warning">
        <h3>
            There Is No Employees
        </h3>
    </div>
}
