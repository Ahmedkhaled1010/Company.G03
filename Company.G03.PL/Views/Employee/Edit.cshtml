@model EmployeeViewModel
@{
    ViewData["Title"] = "Edit";
}

<h1>Update  Employee @Model.Name </h1>
<div asp-validation-summary="All">

</div>
<form asp-action="Edit" enctype="multipart/form-data">
    <partial name="PartialViews/_CreateEditPartialView"></partial>
    <input type="submit" name="name" value="Save" class="btn btn-primary" />
    <a asp-action="Index" class="btn btn-light"> Back to List</a>
</form>

@section ValidationScriptSection
        {
    <partial name="_ValidationScriptsPartial"></partial>
}