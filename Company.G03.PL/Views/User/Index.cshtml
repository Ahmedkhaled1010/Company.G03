@model IEnumerable<UserViewModel>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>All Users</h1>

@if(Model.Count()>0)
{
    <div class="m-2">

        <form class="row offset-2" asp-action="index">
            <div class="col-8">
                <input type="text" name="searchValue" class="form-control" placeholder="User Name" />
            </div>
            <div class="col-4">
                <input type="submit" class="btn btn-info" value="Search" />
            </div>

        </form>
    </div>
    <table class="table table-striped table-hover mt-5">
        <thead>

            <tr>
                <td>
                    @Html.DisplayNameFor(U=>U.Id)
                </td>
                <td>
                    @Html.DisplayNameFor(U => U.FName)
                </td>
                <td>
                    @Html.DisplayNameFor(U => U.LName)
                </td>
                <td>
                    @Html.DisplayNameFor(U => U.Email)
                </td>
                <td>
                    @Html.DisplayNameFor(U => U.Phone)
                </td>
                <td>
                    @Html.DisplayNameFor(U => U.Roles)
                </td>
                <td>
                    Details
                </td>
                <td>
                    Update
                </td>
                <td>
                    Delete
                </td>
            </tr>
        </thead>
        <tbody>

            @foreach(var User in Model)
            {
                <tr>
                    <td>
                        @User.Id
                    </td>
                    <td>
                        @User.FName
                    </td>
                    <td>
                        @User.LName
                    </td>
                    <td>
                        @User.Email
                    </td>
                    <td>
                        @User.Phone
                    </td>
                    <td>
                    @string.Join(",",User.Roles)
</td>
             
                <partial name="_ButtonPartialView" model="@User.Id"/>
                </tr>
            }
        </tbody>

    </table>
}
else
{
    <div>
        <h1>
            There Is No Users
        </h1>
    </div>
}
