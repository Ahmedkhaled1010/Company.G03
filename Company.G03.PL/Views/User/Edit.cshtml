@model UserViewModel
@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Edit user @Model.FName @Model.LName</h1>



<form asp-action="Edit" >


    <div class="form-group">
        <label class="col-form-label" asp-for="FName">

        </label>
        <input class="form-control" asp-for="FName" />
    </div>
    <div class="form-group mb-3">
        <label class="col-form-label" asp-for="LName">

        </label>
        <input class="form-control" asp-for="LName" />
    </div>

    <div class="form-group mb-3">
        <label class="col-form-label" asp-for="Phone">

        </label>
        <input class="form-control" asp-for="Phone" />
    </div>
    

    <input type="submit" class="btn btn-warning" value="Save"/>
    <a asp-action="Index" class="btn btn-light"> Back to List</a>

</form>

